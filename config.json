  "logistics": {
    "providers": [
      { "id": "black_cat", "name": "黑貓宅急便", "prefix": "BC-" },
      { "id": "hsinchu", "name": "新竹物流", "prefix": "HC-" },
      { "id": "pelican", "name": "台灣宅配通", "prefix": "TC-" }
    ],
    "statuses": [
      { "key": "PendingShipment", "label": "待出貨" },
      { "key": "InTransit", "label": "運送中 (路上)" },
      { "key": "Delivered", "label": "已送達 (到貨)" },
      { "key": "Completed", "label": "已完成" }
    ]
  },
  "returns": {
    "policy": "DualApprovalRequired",
    "description": "消費者退貨申請同時通知賣家與平台管理員，必須平台與賣家雙方均審核同意後，方可啟動退款與逆向物流入庫",
    "reasons": [
      "規格不符",
      "包裝破損",
      "商品瑕疵",
      "買家改意退貨",
      "幼貓健康疑慮"
    ]
  },
  "adminBankAccount": {
    "bankName": "國泰世華商業銀行 (013)",
    "branchName": "台北總行營業部",
    "accountNumber": "013-888-99998888",
    "accountName": "派特怕寵物科技股份有限公司"
  },
  "payment": {
    "enabledMethods": [
      { "id": "atm_transfer", "name": "ATM 銀行匯款 (管理員指定對帳戶頭)", "active": true }
    ],
    "disabledMethods": [
      { "id": "credit_card", "name": "信用卡 (Visa / Master / JCB)", "active": false, "reason": "暫時灰色未開放 (尚未開發)" },
      { "id": "ecpay", "name": "綠界金流 (ECPay)", "active": false, "reason": "暫時灰色未開放 (尚未開發)" },
      { "id": "line_pay", "name": "LINE Pay", "active": false, "reason": "暫時灰色未開放 (尚未開發)" }
    ]
  },
  "kittenCardStyles": [
    { "id": "polaroid", "name": "拍立得日常實拍風", "badge": "📷 拍立得日常實拍" },
    { "id": "pedigree", "name": "賽級尊榮黑金卡", "badge": "👑 CFA 賽級名門血統" },
    { "id": "reel", "name": "影片膠捲動態風", "badge": "🎞️ REEL 35MM 實拍動態" },
    { "id": "macaron", "name": "甜心粉彩馬卡龍", "badge": "🧁 甜心馬卡龍萌寵" }
  ],
  "environments": {
    "_說明": "實際環境由建置時的 NEXT_PUBLIC_APP_ENV 決定 (staging | production)，未設定時預設 staging。兩個環境必須是兩個網址、兩個資料庫。",
    "default": "staging",
    "staging": {
      "label": "展示站 STAGING",
      "description": "測試與展示環境，開放測試便捷工具、模擬金流與一鍵切換角色",
      "siteUrl": "https://area.petpa.tw/shop",
      "dbName": "PETPA",
      "showEnvBanner": true,
      "oneClickRoleSwitch": true,
      "prefillDemoCredentials": true,
      "mockLogisticsWebhook": true,
      "mockBankTransferVerification": true,
      "allowMockDataFallback": true,
      "requireRealKycForSellers": false,
      "requireDualEsignForPets": false,
      "requireVirtualAtmWebhooks": false
    },
    "production": {
      "label": "正式站 PRODUCTION",
      "description": "正式營運站，嚴格關閉所有測試捷徑，啟用真實金流、電子發票、物流API、KYC與合約簽署",
      "siteUrl": "",
      "dbName": "PETPA_PROD",
      "showEnvBanner": false,
      "oneClickRoleSwitch": false,
      "prefillDemoCredentials": false,
      "mockLogisticsWebhook": false,
      "mockBankTransferVerification": false,
      "allowMockDataFallback": false,
      "requireRealKycForSellers": true,
      "requireDualEsignForPets": true,
      "requireVirtualAtmWebhooks": true
    }
  },
  "productionReadiness": {
    "_說明": "正式站上線前必須全部 ready=true。ready=false 的功能在正式站會自動鎖住，不會退回展示站的假流程。",
    "realAuth": { "label": "真實登入驗證 (密碼雜湊 + JWT Cookie + 2FA)", "ready": false },
    "ordersInAtlas": { "label": "訂單/退貨/物流狀態寫入 MongoDB (目前在瀏覽器 localStorage)", "ready": false },
    "atmVirtualAccount": { "label": "ATM 每筆訂單專屬虛擬帳號 + 銀行入帳 Webhook", "ready": false },
    "logisticsApi": { "label": "黑貓/綠界物流 API 自動取號與貨態回傳", "ready": false },
    "sellerKyc": { "label": "賣家實名 KYC 文件上傳與審核", "ready": false },
    "petEsign": { "label": "特寵活體買賣電子契約簽署", "ready": false },
    "productionSiteUrl": { "label": "正式站網址與 SSL 憑證", "ready": false }
  }
}
