    "supportEmail": "support@petpa.tw",
    "supportPhone": "02-8888-9999"
  },
  "auth": {
    "roles": ["super_admin", "admin", "seller", "buyer", "guest"],
    "adminDomains": ["admin@petpa.tw", "root@petpa.tw"],
